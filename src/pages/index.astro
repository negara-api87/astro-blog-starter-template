---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b)=> b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="ExteriorCraft USA - Home Exterior Ideas & Cost Guide">
  <h2>Latest USA Home Exterior Guides</h2>
  <p>Auto-updated AI generated content for USA homeowners.</p>
  {posts.map(p => (
    <div class="card">
      <h3><a href={`/blog/${p.slug}/`}>{p.data.title}</a></h3>
      <p>{p.data.description}</p>
      <small>{p.data.pubDate.toDateString()}</small>
    </div>
  ))}
</Layout>